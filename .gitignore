# ── Rust / Cargo ──────────────────────────────────────────────────────────────
# Compiled output and executables
debug/
target/

# Rustfmt backup files
**/*.rs.bk

# MSVC Windows build artifacts
*.pdb
*.lib
*.rsp

# ── Soroban / Stellar ─────────────────────────────────────────────────────────
# Compiled WASM output (checked in only when intentionally published)
*.wasm

# Soroban test snapshots — regenerated automatically on test runs
test_snapshots/
**/.soroban/

# proptest failure-seed files
**/proptest-regressions/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
# JetBrains (IntelliJ, CLion, RustRover)
.idea/
*.iml

# Visual Studio Code (keep .vscode/settings.json if team-shared, exclude personal)
# .vscode/ is intentionally tracked for shared launch/extension config

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Node.js / TypeScript SDK ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# TypeScript build output
sdk/typescript/dist/
sdk/typescript/build/
sdk/typescript/*.tsbuildinfo

# Jest coverage and cache
coverage/
.jest-cache/
**/__snapshots__/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# Stellar / Soroban key files — never commit private keys
*.stellar-key
*.secret

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Misc ──────────────────────────────────────────────────────────────────────
# Temporary and scratch files
*.tmp
*.bak
*.orig
Somzilla.md
