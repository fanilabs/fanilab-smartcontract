{
  "name": "@fanilab/sdk",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript SDK for FaniLab smart contracts on Stellar Soroban",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "browser": "dist/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "smoke:browser": "node scripts/browser-import-smoke.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "escrow",
    "delivery",
    "blockchain"
  ],
  "author": "FaniLab",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "jest": "^30.5.2",
    "typescript": "^5.0.0",
    "ts-jest": "^29.4.14"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
