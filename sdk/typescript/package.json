  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "typescript": "^5.0.0",
    "ts-jest": "^29.4.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
